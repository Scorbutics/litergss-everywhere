# Generates the C source that compiles the Ruby client code (ruby/litergss/*.rb
# and the images it uses) into the runtime, so `require 'litergss/touch_overlay'`
# works on every platform without files on disk:
#   cmake -DRUBY_DIR=<repo>/ruby -DOUTPUT=<file.c> -P embed_ruby_client.cmake
#
# The generated litergss_load_ruby_client() (called by extension-init.c once
# LiteRGSS is initialized) sets LiteRGSS::TouchOverlay::IMAGES, evaluates the
# Ruby source and provides the feature. Loading it only defines modules: the
# host decides whether to call LiteRGSS::TouchOverlay.install.

if(NOT RUBY_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "Pass -DRUBY_DIR=<ruby client dir> -DOUTPUT=<generated .c>")
endif()

set(_source "${RUBY_DIR}/litergss/touch_overlay.rb")
file(GLOB _images "${RUBY_DIR}/litergss/touch_overlay/*.png")
list(SORT _images)
if(NOT EXISTS "${_source}" OR NOT _images)
    message(FATAL_ERROR "Missing ${_source} or its images in ${RUBY_DIR}/litergss/touch_overlay/")
endif()

# C array initializer of a file's bytes, 16 per line (CMake regexes have no {n})
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 _line_of_bytes)
function(_bytes_of path out_var)
    file(READ "${path}" _hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "(${_line_of_bytes})" "\\1\n    " _bytes "${_bytes}")
    set(${out_var} "${_bytes}" PARENT_SCOPE)
endfunction()

set(_c "/* Generated by embed_ruby_client.cmake from ruby/litergss: do not edit. */\n")
string(APPEND _c "#include \"ruby.h\"\n\nvoid litergss_load_ruby_client(void);\n\n")

_bytes_of("${_source}" _src_bytes)
string(APPEND _c "static const unsigned char touch_overlay_rb[] = {\n    ${_src_bytes}\n};\n\n")

set(_table "")
set(_index 0)
foreach(_image IN LISTS _images)
    get_filename_component(_name "${_image}" NAME_WE)
    _bytes_of("${_image}" _img_bytes)
    string(APPEND _c "static const unsigned char image_${_index}[] = {\n    ${_img_bytes}\n};\n")
    string(APPEND _table "    { \"${_name}\", image_${_index}, sizeof(image_${_index}) },\n")
    math(EXPR _index "${_index} + 1")
endforeach()

string(APPEND _c "
static const struct {
    const char *name;
    const unsigned char *data;
    long size;
} touch_overlay_images[] = {
${_table}};

static VALUE load_touch_overlay(VALUE unused)
{
    VALUE litergss = rb_define_module(\"LiteRGSS\");
    VALUE overlay = rb_define_module_under(litergss, \"TouchOverlay\");
    VALUE images = rb_hash_new();
    VALUE iseq;
    size_t i;

    (void)unused;
    for (i = 0; i < sizeof(touch_overlay_images) / sizeof(touch_overlay_images[0]); i++) {
        VALUE data = rb_str_new((const char *)touch_overlay_images[i].data, touch_overlay_images[i].size);
        rb_hash_aset(images, rb_str_new_cstr(touch_overlay_images[i].name), rb_obj_freeze(data));
    }
    rb_const_set(overlay, rb_intern(\"IMAGES\"), rb_obj_freeze(images));

    /* Compiled with its file name, so backtraces point at the Ruby source */
    iseq = rb_funcall(rb_path2class(\"RubyVM::InstructionSequence\"), rb_intern(\"compile\"), 3,
                      rb_utf8_str_new((const char *)touch_overlay_rb, (long)sizeof(touch_overlay_rb)),
                      rb_str_new_cstr(\"litergss/touch_overlay.rb\"),
                      rb_str_new_cstr(\"litergss/touch_overlay.rb\"));
    rb_funcall(iseq, rb_intern(\"eval\"), 0);
    rb_provide(\"litergss/touch_overlay\");
    return Qnil;
}

/* Never raises: a broken client script must not prevent the VM from starting */
void litergss_load_ruby_client(void)
{
    int state = 0;

    rb_protect(load_touch_overlay, Qnil, &state);
    if (state) {
        VALUE error = rb_errinfo();
        rb_set_errinfo(Qnil);
        rb_warn(\"litergss/touch_overlay failed to load: %\" PRIsVALUE, rb_inspect(error));
    }
}
")

# Only rewrite on change: keeps the object file up to date without rebuilding it
set(_tmp "${OUTPUT}.tmp")
file(WRITE "${_tmp}" "${_c}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${_tmp}" "${OUTPUT}")
file(REMOVE "${_tmp}")
