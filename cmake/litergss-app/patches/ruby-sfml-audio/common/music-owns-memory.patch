Music owns the buffer it streams from (crash in GC, e.g. on PSDK soft reset).

open_from_memory only kept the Ruby String in @memory while sf::Music
streams from its buffer on its own thread. When a Music and its String
became garbage in the same GC run, Ruby could free the String first and
the Music then read freed memory. Copy the bytes into the native object
and stop the stream before the copy is released.

Applied on top of the pinned NuriYuri/sfmlaudio revision; drop it once
upstream carries an equivalent fix.

diff --git a/ext/SFMLAudio/sf_Music.cpp b/ext/SFMLAudio/sf_Music.cpp
index fdb1ac0..0e90a0c 100644
--- a/ext/SFMLAudio/sf_Music.cpp
+++ b/ext/SFMLAudio/sf_Music.cpp
@@ -1,17 +1,31 @@
 #include "rb_common.h"
+#include <string>
 
 
 VALUE rb_cMusic = Qnil;
 
+// sf::Music streams straight from the buffer given to openFromMemory, on its
+// own thread. Keeping only the Ruby String alive (@memory) is not enough:
+// when a Music and its String become garbage in the same GC run, Ruby may
+// free the String first, and the Music (still streaming, or closing its
+// decoder) then reads freed memory. Own a copy instead, and stop the stream
+// before that copy is released (members are destroyed after this body, the
+// sf::Music base after that).
+class RbMusic : public sf::Music {
+public:
+  std::string memory;
+  ~RbMusic() override { stop(); }
+};
+
 void rb_Music_Free(void* data)
 {
-  sf::Music* pdata = reinterpret_cast<sf::Music*>(data);
+  RbMusic* pdata = reinterpret_cast<RbMusic*>(data);
   if(pdata != nullptr) { delete pdata; }
 }
 
 VALUE rb_Music_Alloc(VALUE klass)
 {
-  sf::Music* data = new sf::Music();
+  RbMusic* data = new RbMusic();
   return Data_Wrap_Struct(klass, NULL, rb_Music_Free, data);
 }
 
@@ -23,9 +37,12 @@ VALUE rb_MopenFromFile(VALUE self, VALUE filename) {
 
 VALUE rb_MopenFromMemory(VALUE self, VALUE string) {
   Check_Type(string, T_STRING);
-  RB_GET_DATA(sf::Music, Qfalse);
+  RB_GET_DATA(RbMusic, Qfalse);
   rb_iv_set(self, "@memory", string);
-  return data->openFromMemory(StringValuePtr(string), RSTRING_LEN(string)) ? Qtrue : Qfalse;
+  // The streaming thread may still be reading the current buffer.
+  data->stop();
+  data->memory.assign(RSTRING_PTR(string), RSTRING_LEN(string));
+  return data->openFromMemory(data->memory.data(), data->memory.size()) ? Qtrue : Qfalse;
 }
 
