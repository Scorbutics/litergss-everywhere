+// Position in the file of a looping music that streamed a number of frames since its start
+static unsigned int WrapMusicFrame(Music music, unsigned int frame)
+{
+    unsigned int begin = 0;
+    unsigned int end = 0;
+    GetMusicLoopRegion(music, &begin, &end);
