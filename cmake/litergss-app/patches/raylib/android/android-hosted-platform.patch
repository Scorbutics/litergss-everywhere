PLATFORM=AndroidHosted: raylib renders into a surface the application owns

The platform's sources are new files, not in this patch: raylib.cmake copies
them from cmake/litergss-app/dependencies/files/raylib/ into the source tree
before configuring (src/platforms/rcore_android_hosted.c, the platform;
src/raylib_android_hosted.h, its host API). This patch hooks them into
raylib's build:

- CMakeOptions.txt: AndroidHosted, a PLATFORM value;
- cmake/LibraryConfigurations.cmake: its flags (PLATFORM_ANDROID_HOSTED,
  OpenGL ES 3) and libraries (no native_app_glue);
- src/CMakeLists.txt: raylib_android_hosted.h installed with the public
  headers; the fopen() wrap (APK assets) left to PLATFORM=Android only;
- src/rcore.c: rcore_android_hosted.c, the platform's core.

diff --git a/CMakeOptions.txt b/CMakeOptions.txt
index 5537511..07b7721 100644
--- a/CMakeOptions.txt
+++ b/CMakeOptions.txt
@@ -6,7 +6,7 @@ if(EMSCRIPTEN)
     # When configuring web builds with "emcmake cmake -B build -S .", set PLATFORM to Web by default
     SET(PLATFORM Web CACHE STRING "Platform to build for.")
 endif()
-enum_option(PLATFORM "Desktop;Web;WebRGFW;Android;Raspberry Pi;DRM;SDL;RGFW;Memory" "Platform to build for.")
+enum_option(PLATFORM "Desktop;Web;WebRGFW;Android;AndroidHosted;Raspberry Pi;DRM;SDL;RGFW;Memory" "Platform to build for.")
 
 enum_option(OPENGL_VERSION "OFF;4.3;3.3;2.1;1.1;ES 2.0;ES 3.0;Software" "Force a specific OpenGL Version?")
 
diff --git a/cmake/LibraryConfigurations.cmake b/cmake/LibraryConfigurations.cmake
index 1868049..c803a72 100644
--- a/cmake/LibraryConfigurations.cmake
+++ b/cmake/LibraryConfigurations.cmake
@@ -74,6 +74,15 @@ elseif (${PLATFORM} STREQUAL "Web")
     endif()
     set(CMAKE_STATIC_LIBRARY_SUFFIX ".a")
 
+elseif (${PLATFORM} STREQUAL "AndroidHosted")
+    # Android, rendering into a surface the application owns (raylib_android_hosted.h):
+    # no NativeActivity, no native_app_glue, no asset-manager fopen()
+    set(PLATFORM_CPP "PLATFORM_ANDROID_HOSTED")
+    set(GRAPHICS "GRAPHICS_API_OPENGL_ES3")
+    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+    set(LIBS_PRIVATE log android EGL GLESv3 atomic c)
+    set(LIBS_PUBLIC m)
+
 elseif (${PLATFORM} STREQUAL "Android")
     set(PLATFORM_CPP "PLATFORM_ANDROID")
     set(GRAPHICS "GRAPHICS_API_OPENGL_ES2")
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 5e5dd91..23c16b0 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -26,6 +26,7 @@ set(raylib_public_headers
     rcamera.h
     rlgl.h
     raymath.h
+    raylib_android_hosted.h
     )
 
 # Sources to be compiled
@@ -75,7 +76,7 @@ if (${PLATFORM} MATCHES "Web")
     endif()
 endif()
 
-if (${PLATFORM} MATCHES "Android")
+if (${PLATFORM} STREQUAL "Android")
     # Wrap fopen at link time so all code (including third-party libs) goes
     # through __wrap_fopen, which handles Android APK asset loading
     target_link_options(raylib PUBLIC -Wl,--wrap=fopen)
diff --git a/src/rcore.c b/src/rcore.c
index d99919b..cc7302d 100644
--- a/src/rcore.c
+++ b/src/rcore.c
@@ -548,6 +548,8 @@ const char *TextFormat(const char *text, ...); // Formatting of text with variab
     #include "platforms/rcore_drm.c"
 #elif defined(PLATFORM_ANDROID)
     #include "platforms/rcore_android.c"
+#elif defined(PLATFORM_ANDROID_HOSTED)
+    #include "platforms/rcore_android_hosted.c"
 #elif defined(PLATFORM_MEMORY)
     #include "platforms/rcore_memory.c"
 #else
@@ -624,6 +626,8 @@ void InitWindow(int width, int height, const char *title)
     TRACELOG(LOG_INFO, "Platform backend: NATIVE DRM");
 #elif defined(PLATFORM_ANDROID)
     TRACELOG(LOG_INFO, "Platform backend: ANDROID");
+#elif defined(PLATFORM_ANDROID_HOSTED)
+    TRACELOG(LOG_INFO, "Platform backend: ANDROID (hosted surface)");
 #elif defined(PLATFORM_MEMORY)
     TRACELOG(LOG_INFO, "Platform backend: MEMORY (No OS)");
 #else
@@ -1891,7 +1895,7 @@ void TraceLog(int logType, const char *text, ...)
         return;
     }
 
-#if defined(PLATFORM_ANDROID)
+#if defined(PLATFORM_ANDROID) || defined(PLATFORM_ANDROID_HOSTED)
     switch (logType)
     {
         case LOG_TRACE: __android_log_vprint(ANDROID_LOG_VERBOSE, "raylib", text, args); break;
